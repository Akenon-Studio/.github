{
  "_comment": "The org project board (design 6.6). apply-board.py creates the board, its fields, linked repos and views; verify-settings.py checks them. Owner is the built-in Assignees field; Type is the issue type, usable in filters but not as a column through the API. The API can set a view's name, layout, filter and columns but not its grouping, sorting or board column field: apply-board.py lists those as steps to do by hand, and verify-settings.py checks them. Single-select option names match the issue form answers exactly.",
  "title": "Akenon Studio",
  "description": "All work across the org: one board, every repo. Fields come from the issue forms.",
  "fields": [
    {
      "name": "Status",
      "type": "SINGLE_SELECT",
      "options": [
        {
          "name": "Todo",
          "color": "GRAY",
          "description": "Not started"
        },
        {
          "name": "In progress",
          "color": "BLUE",
          "description": "Someone is working on it"
        },
        {
          "name": "Waiting for human",
          "color": "ORANGE",
          "description": "Paused until a person answers or reviews"
        },
        {
          "name": "Blocked",
          "color": "RED",
          "description": "Cannot move until something else is done"
        },
        {
          "name": "In review",
          "color": "PURPLE",
          "description": "PR open, waiting for approval"
        },
        {
          "name": "Done",
          "color": "GREEN",
          "description": "Finished"
        }
      ]
    },
    {
      "name": "Discipline",
      "type": "SINGLE_SELECT",
      "options": [
        {
          "name": "Software",
          "color": "BLUE",
          "description": ""
        },
        {
          "name": "Animation",
          "color": "PURPLE",
          "description": ""
        },
        {
          "name": "Hardware",
          "color": "ORANGE",
          "description": ""
        },
        {
          "name": "Brand",
          "color": "PINK",
          "description": ""
        },
        {
          "name": "Marketing",
          "color": "YELLOW",
          "description": ""
        },
        {
          "name": "Legal and admin",
          "color": "GRAY",
          "description": ""
        }
      ]
    },
    {
      "name": "Priority",
      "type": "SINGLE_SELECT",
      "options": [
        {
          "name": "Urgent",
          "color": "RED",
          "description": ""
        },
        {
          "name": "High",
          "color": "ORANGE",
          "description": ""
        },
        {
          "name": "Medium",
          "color": "YELLOW",
          "description": ""
        },
        {
          "name": "Low",
          "color": "GRAY",
          "description": ""
        }
      ]
    },
    {
      "name": "Epic",
      "type": "SINGLE_SELECT",
      "options_from": "epics",
      "_comment": "One option per epic, kept by issue_fields.py from each issue's parents, never set by hand (design 6.6): the option's name is the epic's title, its description the epic's repo#n. apply-board.py creates the field with the epics that exist; verify-settings.py checks only that it exists."
    },
    {
      "name": "Iteration",
      "type": "ITERATION",
      "_comment": "Weekly, Saturday to Friday: the Friday planning meeting closes one week and commits the next.",
      "start_date": "2026-10-03",
      "duration": 7
    },
    {
      "name": "Audit",
      "type": "SINGLE_SELECT",
      "_comment": "Audit findings only, phase 1. Options match the Audit finding form.",
      "options": [
        {
          "name": "Secrets and access",
          "color": "GRAY",
          "description": ""
        },
        {
          "name": "Legal and IP",
          "color": "GRAY",
          "description": ""
        },
        {
          "name": "Code quality",
          "color": "GRAY",
          "description": ""
        },
        {
          "name": "Docs",
          "color": "GRAY",
          "description": ""
        },
        {
          "name": "Release readiness",
          "color": "GRAY",
          "description": ""
        },
        {
          "name": "Onboarding",
          "color": "GRAY",
          "description": ""
        },
        {
          "name": "Privacy",
          "color": "GRAY",
          "description": ""
        },
        {
          "name": "Hardware",
          "color": "GRAY",
          "description": ""
        }
      ]
    },
    {
      "name": "Severity",
      "type": "SINGLE_SELECT",
      "_comment": "Audit findings only, phase 1.",
      "options": [
        {
          "name": "Critical",
          "color": "RED",
          "description": ""
        },
        {
          "name": "High",
          "color": "ORANGE",
          "description": ""
        },
        {
          "name": "Medium",
          "color": "YELLOW",
          "description": ""
        },
        {
          "name": "Low",
          "color": "GRAY",
          "description": ""
        }
      ]
    },
    {
      "name": "Peras",
      "type": "TEXT",
      "_comment": "Cycle state and link, intents only. Set by Peras, never by hand."
    }
  ],
  "linked_repos": "managed",
  "views": [
    {
      "name": "Needs a human",
      "layout": "TABLE_LAYOUT",
      "filter": "is:open -label:needs-fields status:\"Waiting for human\",\"In review\"",
      "fields": [
        "Title",
        "Status",
        "Assignees",
        "Repository",
        "Peras",
        "Linked pull requests"
      ],
      "group_by": "Status",
      "sort": [
        "Created",
        "ASC"
      ],
      "_comment": "Filters cannot OR across fields, so this relies on Status: a new Decision or Bug starts in Waiting for human (form automation), an issue whose PR awaits review is In review, and Peras sets Waiting for human when a cycle pauses."
    },
    {
      "name": "Needs fixing",
      "_comment": "Issues the automation flagged (issue-fields, issue-sweep): each has one comment saying what to fix. Every other view but My work, Epics and Overview leaves them out, so this is where they show (design 6.6).",
      "layout": "TABLE_LAYOUT",
      "filter": "is:open label:needs-fields",
      "fields": [
        "Title",
        "Status",
        "Assignees",
        "Repository"
      ],
      "sort": [
        "Created",
        "ASC"
      ]
    },
    {
      "name": "My work",
      "layout": "TABLE_LAYOUT",
      "filter": "is:open assignee:@me -status:Done",
      "fields": [
        "Title",
        "Epic",
        "Status",
        "Priority",
        "Iteration",
        "Repository",
        "Labels"
      ],
      "group_by": "Status",
      "sort": [
        "Priority",
        "ASC"
      ],
      "_comment": "What I and my agents (who work as my login) are on, flagged issues included: their needs-fields label shows."
    },
    {
      "name": "This week",
      "layout": "BOARD_LAYOUT",
      "filter": "-label:needs-fields iteration:@current",
      "fields": [
        "Title",
        "Assignees",
        "Status",
        "Discipline",
        "Priority"
      ],
      "column": "Status"
    },
    {
      "name": "Backlog",
      "layout": "TABLE_LAYOUT",
      "filter": "is:open -label:needs-fields no:iteration -status:Done",
      "fields": [
        "Title",
        "Epic",
        "Discipline",
        "Priority",
        "Assignees",
        "Repository",
        "Labels"
      ],
      "group_by": "Discipline",
      "sort": [
        "Priority",
        "ASC"
      ],
      "_comment": "Unplanned work, for Friday planning."
    },
    {
      "name": "Epics",
      "layout": "TABLE_LAYOUT",
      "filter": "is:open type:Epic",
      "fields": [
        "Title",
        "Sub-issues progress",
        "Priority",
        "Assignees"
      ],
      "sort": [
        "Priority",
        "ASC"
      ],
      "_comment": "Each open epic and how much of it is done and left (design 6.6)."
    },
    {
      "name": "Overview",
      "layout": "BOARD_LAYOUT",
      "filter": "is:issue",
      "fields": [
        "Title",
        "Assignees",
        "Priority",
        "Labels"
      ],
      "column": "Status",
      "_note": "Sliced by Discipline (the side list with a count per discipline), set by hand: the API can neither set nor read a view slice, so this is not checked."
    }
  ]
}
